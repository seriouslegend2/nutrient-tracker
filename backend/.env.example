# Generic examples only. A supplied service-role key was exposed: rotate it in
# Supabase, never document its value, and use only the rotated key here.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-rotated-service-role-key

# Generate a new value of at least 32 bytes and match both frontend secrets.
JWT_SECRET_KEY=replace-with-new-shared-jwt-secret-at-least-32-bytes
JWT_ALGORITHM=HS256
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

OPENAI_API_KEY=
CHAT_MODEL=gpt-4.1-nano
VISION_MODEL=gpt-4.1-nano
AUDIO_MODEL=gpt-4o-mini-transcribe
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=nutrient-tracker-agents
LANGSMITH_TRACING=false
REDIS_URL=
