# Generic browser-visible Supabase project values. Never add a service-role key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# Used only by Next.js route handlers. Never add a NEXT_PUBLIC_ prefix. Generate
# a replacement of at least 32 bytes and match backend JWT_SECRET_KEY.
BACKEND_API_URL=http://localhost:8000
BACKEND_JWT_SECRET=replace-with-new-shared-jwt-secret-at-least-32-bytes
